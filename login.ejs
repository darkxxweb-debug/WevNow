<!DOCTYPE html>
<html lang="en">
<head>
  <title>WaveHub · Log in</title>
  <%- include('head') %>
</head>
<body>
  <div class="shell">
    <div class="topbar">
      <button class="menu-toggle" aria-label="Open menu"><i class="fa-solid fa-bars"></i></button>
      <div class="brand-name">Log in</div>
    </div>

    <%- include('sidemenu') %>

    <p class="page-sub">Welcome back. Log in to continue.</p>

    <form class="card" id="loginForm">
      <div class="field">
        <label for="username">Username *</label>
        <input type="text" id="username" placeholder="Your username" required>
      </div>
      <div class="field">
        <label for="password">Password *</label>
        <input type="password" id="password" placeholder="Your password" required>
      </div>

      <button class="btn btn-primary" type="submit" id="submitBtn">
        <i class="fa-solid fa-right-to-bracket"></i> Log in
      </button>
      <div class="status-msg" id="statusMsg"></div>
    </form>

    <p class="page-sub" style="text-align:center;margin-top:16px;">
      No account yet? <a href="/register" style="color:var(--accent);text-decoration:underline;">Register</a>
    </p>
  </div>

  <%- include('bottomnav') %>
  <script src="/js/auth.js"></script>
</body>
</html>
