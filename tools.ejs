<!DOCTYPE html>
<html lang="en">
<head>
  <title>WaveHub · Tools</title>
  <%- include('head') %>
</head>
<body>
  <div class="shell">
    <div class="topbar">
      <button class="menu-toggle" aria-label="Open menu"><i class="fa-solid fa-bars"></i></button>
      <div class="brand">
        <div class="brand-mark"><span></span><span></span><span></span><span></span></div>
        <div class="brand-name">Wave<span>Hub</span></div>
      </div>
      <button class="notif-bell-btn" id="notifBell" aria-label="Notifications">
        <i class="fa-solid fa-bell"></i>
        <span class="notif-dot" id="notifDot" style="display:none"></span>
      </button>
    </div>

    <%- include('sidemenu') %>

    <h1 class="page-title">Tools &amp; apps</h1>
    <p class="page-sub">Shared by the community. Tap the plus button to add your own (registered users only).</p>

    <div class="store-tabs" id="storeTabs">
      <div class="store-tab active" data-mode="new"><i class="fa-solid fa-star"></i> All apps</div>
      <div class="store-tab" data-mode="top"><i class="fa-solid fa-fire"></i> Top downloads</div>
    </div>

    <div class="field" style="margin-bottom:14px;">
      <input type="text" id="searchInput" placeholder="Search tools...">
    </div>

    <div class="chip-row" id="categoryRow">
      <span class="chip active" data-cat="All">All</span>
    </div>

    <div class="tool-list" id="toolList"></div>

    <div class="empty-state" id="emptyState" style="display:none">
      <div class="glyph"><i class="fa-solid fa-box-open"></i></div>
      <div>No tools yet. Be the first to add one.</div>
    </div>
    <footer class="site-footer">All Rights are reserved | DarkX-Ultra Tech 2026</footer>
  </div>

  <%- include('bottomnav') %>

  <script src="/js/tools.js"></script>
</body>
</html>
