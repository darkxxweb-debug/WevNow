<!DOCTYPE html>
<html lang="en">
<head>
  <title>WaveHub · VCF Panel</title>
  <%- include('head') %>
</head>
<body data-slug="<%= slug %>">
  <div class="shell">
    <div class="topbar">
      <button class="menu-toggle" aria-label="Open menu"><i class="fa-solid fa-bars"></i></button>
      <div class="brand-name" id="panelTitle">VCF Panel</div>
      <button class="notif-bell-btn" id="notifBell" aria-label="Notifications">
        <i class="fa-solid fa-bell"></i>
        <span class="notif-dot" id="notifDot" style="display:none"></span>
      </button>
    </div>

    <%- include('sidemenu') %>

    <p class="page-sub" id="panelSub">Add your number to this contact panel.</p>

    <form class="card" id="submitForm">
      <div class="field">
        <label for="country">Country</label>
        <select id="country"></select>
      </div>

      <div class="field">
        <label for="fullName">Your name *</label>
        <input type="text" id="fullName" placeholder="e.g. John Mahmoud" required maxlength="60">
      </div>

      <div class="field">
        <label for="number">Phone number *</label>
        <div class="number-input-wrap">
          <span class="dial-code-prefix" id="dialCodePrefix">+255</span>
          <input type="tel" id="number" placeholder="775710774" required>
        </div>
      </div>

      <button class="btn btn-primary" type="submit" id="submitBtn">
        <i class="fa-solid fa-check"></i> Save my number
      </button>
      <div class="status-msg" id="statusMsg"></div>
    </form>

    <div class="referral-box" id="ownerBox" style="display:none;margin-top:16px;">
      <div class="tool-name" id="countInfo"></div>
      <div class="vcf-actions" style="margin-top:10px;">
        <a class="btn btn-teal" id="downloadLink" href="#"><i class="fa-solid fa-download"></i> Download .vcf</a>
      </div>
    </div>
  </div>

  <%- include('bottomnav') %>
  <script src="/js/countries.js"></script>
  <script src="/js/vcf-panel.js"></script>
</body>
</html>
