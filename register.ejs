<!DOCTYPE html>
<html lang="en">
<head>
  <title>WaveHub · Register</title>
  <%- include('head') %>
</head>
<body>
  <div class="shell">
    <div class="topbar">
      <button class="menu-toggle" aria-label="Open menu"><i class="fa-solid fa-bars"></i></button>
      <div class="brand-name">Create account</div>
    </div>

    <%- include('sidemenu') %>

    <p class="page-sub">Register to upload tools, create referral links, and manage VCF panels.</p>

    <form class="card" id="registerForm">
      <div class="field">
        <label for="username">Username *</label>
        <input type="text" id="username" placeholder="e.g. mrx_dev" required minlength="3">
      </div>
      <div class="field">
        <label for="password">Password *</label>
        <input type="password" id="password" placeholder="At least 5 characters" required minlength="5">
      </div>
      <div class="field">
        <label for="refCode">Referral code (optional)</label>
        <input type="text" id="refCode" placeholder="Invite code from a friend">
      </div>

      <button class="btn btn-primary" type="submit" id="submitBtn">
        <i class="fa-solid fa-user-plus"></i> Register
      </button>
      <div class="status-msg" id="statusMsg"></div>
    </form>

    <p class="page-sub" style="text-align:center;margin-top:16px;">
      Already have an account? <a href="/login" style="color:var(--accent);text-decoration:underline;">Log in</a>
    </p>
  </div>

  <%- include('bottomnav') %>
  <script src="/js/auth.js"></script>
</body>
</html>
