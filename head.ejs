<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<script>
  (function () {
    try {
      if (localStorage.getItem('wh_theme') === 'blue') {
        document.documentElement.setAttribute('data-theme', 'blue');
      }
    } catch (e) {}
  })();
</script>
