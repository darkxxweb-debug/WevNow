<!DOCTYPE html>
<html lang="en">
<head>
  <title>WaveHub · Downloader</title>
  <%- include('head') %>
</head>
<body>
  <div class="shell">
    <div class="topbar">
      <button class="menu-toggle" aria-label="Open menu"><i class="fa-solid fa-bars"></i></button>
      <div class="brand">
        <div class="brand-mark"><span></span><span></span><span></span><span></span></div>
        <div class="brand-name">Wave<span>Hub</span></div>
      </div>
      <button class="notif-bell-btn" id="notifBell" aria-label="Notifications">
        <i class="fa-solid fa-bell"></i>
        <span class="notif-dot" id="notifDot" style="display:none"></span>
      </button>
    </div>

    <%- include('sidemenu') %>

    <h1 class="page-title">Download anything</h1>
    <p class="page-sub">Paste a link from YouTube, TikTok, Instagram, or Facebook. We'll fetch the best quality for you.</p>

    <div class="platform-tabs" id="platformTabs">
      <div class="platform-tab active" data-platform="youtube"><i class="fa-brands fa-youtube"></i> YouTube</div>
      <div class="platform-tab" data-platform="tiktok"><i class="fa-brands fa-tiktok"></i> TikTok</div>
      <div class="platform-tab" data-platform="ig"><i class="fa-brands fa-instagram"></i> Instagram</div>
      <div class="platform-tab" data-platform="fb"><i class="fa-brands fa-facebook"></i> Facebook</div>
    </div>

    <div class="card">
      <div class="field">
        <label for="url" id="urlLabel">Link</label>
        <input type="text" id="url" placeholder="https://www.youtube.com/watch?v=..." autocomplete="off">
      </div>
      <button class="btn btn-primary" id="downloadBtn">
        <i class="fa-solid fa-download"></i> Get download links
      </button>

      <div class="status-msg" id="statusMsg"></div>
    </div>

    <div class="result-card" id="resultCard">
      <div class="result-head">
        <img class="result-thumb" id="resultThumb" src="" alt="">
        <div class="result-title" id="resultTitle"></div>
      </div>

      <div class="preview-wrap" id="previewWrap"></div>

      <div class="result-actions" id="resultActions">
        <a class="btn btn-teal" id="audioLink" target="_blank" rel="noopener" style="display:none">
          <i class="fa-solid fa-music"></i> Audio
        </a>
        <a class="btn btn-ghost" id="videoLink" target="_blank" rel="noopener" style="display:none">
          <i class="fa-solid fa-video"></i> Video
        </a>
      </div>
      <div class="result-actions" id="mediaGrid" style="flex-wrap:wrap;"></div>
    </div>
  </div>

  <%- include('bottomnav') %>

  <script src="/js/download.js"></script>
</body>
</html>
